# Rajjo AI Desktop Agent - Environment Configuration Template
# Copy this file to .env and configure your desired settings / API keys.

# Base Data Directory (Defaults to ~/.rajjo or %APPDATA%/Rajjo)
# RAJJO_DATA_DIR=C:/Users/username/.rajjo

# Active Default Model Provider (openai, groq, ollama, gguf, custom)
RAJJO_DEFAULT_PROVIDER=openai
RAJJO_DEFAULT_MODEL=nanbeige 4.2

# Local Ollama URL
OLLAMA_BASE_URL=http://localhost:11434

# Local GGUF Model Path (e.g., C:/Models/llama-3-8b-instruct.Q4_K_M.gguf)
RAJJO_GGUF_MODEL_PATH=

# Execution Limits
RAJJO_MAX_ITERATIONS=10
RAJJO_SHELL_TIMEOUT=30
