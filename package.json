{
  "name": "rajjo",
  "version": "2.0.0",
  "description": "Local-First Autonomous AI Desktop Agent - Professional Edition",
  "author": "Rajat Singh",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND,ELECTRON\" -c \"cyan,magenta,green\" \"npm run backend:dev\" \"npm run frontend:dev\" \"wait-on -t 60000 http://127.0.0.1:8000/health http://localhost:5173 && npm run electron:dev\"",
    "setup": "node scripts/setup.js",
    "backend:dev": "node scripts/backend_dev.js",
    "frontend:dev": "npm --prefix frontend run dev",
    "electron:dev": "electron .",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "node scripts/build_backend.js",
    "test": "node scripts/run_test.js",
    "dist": "npm run build:frontend && node scripts/build_backend.js && electron-builder",
    "install:all": "node scripts/setup.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.rajjo.ai",
    "productName": "Rajjo",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rajjo",
      "artifactName": "Rajjo-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "backend/dist/rajjo_backend.exe",
        "to": "bin/rajjo_backend.exe"
      }
    ],
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "assets/**/*"
    ]
  },
  "allowScripts": {
    "electron@30.5.1": true
  }
}
